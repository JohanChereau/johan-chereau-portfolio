---
import { getCollection, render } from 'astro:content';
import ProjectDetail from '../../../components/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => project.data.locale === 'fr');
  return projects.map((project) => ({ params: { projectId: project.data.projectId }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<ProjectDetail locale="fr" project={project} Content={Content} />
