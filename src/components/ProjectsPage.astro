---
import { getCollection } from 'astro:content';
import type { Locale } from '../config';
import { t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectCard from './ProjectCard.astro';

const { locale } = Astro.props as { locale: Locale };
const copy = t(locale);
const projects = (await getCollection('projects'))
  .filter((project) => project.data.locale === locale)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout locale={locale} title={copy.projects.title} description={copy.projects.intro} canonicalPath={`/${locale}/projects/`}>
  <Header locale={locale} />
  <main id="main" class="page-main shell section-pad">
    <div class="page-hero"><p class="eyebrow">Portfolio / {copy.projects.title}</p><h1>{copy.projects.title}</h1><p>{copy.projects.intro}</p></div>
    {projects.length > 0 ? (
      <div class="projects-grid-all">{projects.map((project, index) => <ProjectCard project={project} locale={locale} index={index} />)}</div>
    ) : (
      <p class="empty-state">{copy.projects.empty}</p>
    )}
  </main>
  <Footer locale={locale} />
</BaseLayout>
