---
import { getCollection } from "astro:content";
import { siteConfig, type Locale } from "../config";
import { t } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import TechStack from "./TechStack.astro";
import ExperienceStrip from "./ExperienceStrip.astro";
import CapabilityVisual from "./CapabilityVisual.astro";

const { locale } = Astro.props as { locale: Locale };
const copy = t(locale);
const projects = (await getCollection("projects"))
  .filter((project) => project.data.locale === locale && project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<BaseLayout locale={locale} canonicalPath={`/${locale}/`}>
  <Header locale={locale} />
  <main id="main">
    <section class="hero shell section-pad">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot"></span>{copy.hero.eyebrow}
        </p>
        <h1>
          <span>{copy.hero.titleA}</span><strong>{copy.hero.titleB}</strong>
        </h1>
        <p class="hero-body">{copy.hero.body}</p>
        <div class="hero-actions">
          <a class="button primary" href="#work"
            >{copy.hero.primary}<span aria-hidden="true">↓</span></a
          >
          <a class="button secondary" href="#contact"
            >{copy.hero.secondary}<span aria-hidden="true">↗</span></a
          >
        </div>
        <p class="availability"><span></span>{copy.hero.availability}</p>
      </div>

      <div class="logo-stage" aria-hidden="true">
        <div class="logo-glow"></div>
        <div class="orbit orbit-a"></div>
        <div class="orbit orbit-b"></div>
        <div class="logo-object"><img src="/brand/logo.svg" alt="" /></div>
        <span class="orbit-label label-a">EDTECH</span>
        <span class="orbit-label label-b">MOBILITY</span>
        <span class="orbit-label label-c">PRODUCT</span>
      </div>
      <div class="hero-scroll" aria-hidden="true"><span></span>SCROLL</div>
    </section>

    <section class="section-pad shell" id="work">
      <div class="section-topline">
        <SectionHeading
          eyebrow={copy.work.eyebrow}
          title={copy.work.title}
          body={copy.work.body}
        />
        <a class="text-link desktop-only" href={`/${locale}/projects/`}
          >{copy.work.all} ↗</a
        >
      </div>
      {
        projects.length > 0 ? (
          <div class="featured-projects">
            {projects.map((project, index) => (
              <ProjectCard
                project={project}
                locale={locale}
                large={index === 0}
                index={index}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">{copy.projects.empty}</p>
        )
      }
      <a
        class="text-link mobile-only section-link"
        href={`/${locale}/projects/`}>{copy.work.all} ↗</a
      >
    </section>

    <section class="section-pad shell" id="expertise">
      <SectionHeading
        eyebrow={copy.build.eyebrow}
        title={copy.build.title}
        body={copy.build.body}
      />
      <div class="capability-grid">
        {
          copy.build.cards.map(([index, title, body], cardIndex) => (
            <article
              class="capability-card"
              data-reveal
              style={`--reveal-delay:${Math.min(cardIndex * 55, 110)}ms`}
            >
              <span class="capability-index">{index}</span>
              <CapabilityVisual kind={(cardIndex + 1) as 1 | 2 | 3} />
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad shell about-section" id="about">
      <div class="about-aside" data-reveal>
        <p class="eyebrow">{copy.about.eyebrow}</p>
        <div class="dual-path" aria-hidden="true">
          <span class="dual-path-label dual-path-dev">DEV</span>
          <span class="dual-path-label dual-path-mobility">MOBILITY</span>
          <svg viewBox="0 0 300 112" role="presentation">
            <defs>
              <linearGradient id="pathDev" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="currentColor" stop-opacity=".18"
                ></stop>
                <stop offset="1" stop-color="var(--cyan)"></stop>
              </linearGradient>
              <linearGradient id="pathMobility" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="currentColor" stop-opacity=".18"
                ></stop>
                <stop offset="1" stop-color="var(--violet)"></stop>
              </linearGradient>
            </defs>
            <path
              class="dual-path-line"
              d="M78 28H132L181 56H217"
              stroke="url(#pathDev)"></path>
            <path
              class="dual-path-line"
              d="M78 84H132L181 56"
              stroke="url(#pathMobility)"></path>
            <circle class="dual-path-node" cx="181" cy="56" r="4"></circle>
          </svg>
          <span class="dual-path-target">PRODUCT</span>
        </div>
      </div>
      <div class="about-copy" data-reveal>
        <h2>{copy.about.title}</h2>
        <div class="about-columns">
          <p>{copy.about.p1}</p><p>{copy.about.p2}</p>
        </div>
        <div class="about-note"><span>01</span><p>{copy.about.note}</p></div>
      </div>
    </section>

    <section class="section-pad shell experience-section">
      <SectionHeading
        eyebrow={copy.experience.eyebrow}
        title={copy.experience.title}
        body={copy.experience.body}
      />
      <ExperienceStrip locale={locale} />
    </section>

    <section class="section-pad shell tech-section">
      <SectionHeading
        eyebrow={copy.stack.eyebrow}
        title={copy.stack.title}
        body={copy.stack.body}
      />
      <TechStack locale={locale} />
    </section>

    <section class="section-pad shell contact-section" id="contact">
      <div class="contact-copy" data-reveal>
        <p class="eyebrow">{copy.contact.eyebrow}</p>
        <h2>{copy.contact.title}</h2>
        <p>{copy.contact.body}</p>
        <div class="contact-direct">
          <a href={`mailto:${siteConfig.email}`}
            >{siteConfig.email}<span>↗</span></a
          >
          <a href={siteConfig.linkedin} target="_blank" rel="noreferrer"
            >LinkedIn<span>↗</span></a
          >
          <a href={siteConfig.github} target="_blank" rel="noreferrer"
            >GitHub<span>↗</span></a
          >
        </div>
      </div>

      <form
        class="contact-form"
        data-reveal
        style="--reveal-delay:60ms"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-contact-form
      >
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="from_name" value="Portfolio Johan Chereau" />

        <input
          type="checkbox"
          name="botcheck"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="field-row">
          <label>
            <span>01 · {copy.contact.name}</span>
            <input
              name="name"
              autocomplete="name"
              required
              maxlength="80"
              placeholder={locale === "fr" ? "Votre nom" : "Your name"}
            />
          </label>

          <label>
            <span>02 · {copy.contact.email}</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="name@example.com"
            />
          </label>
        </div>

        <label>
          <span>03 · {copy.contact.subject}</span>
          <input
            name="subject"
            required
            maxlength="120"
            placeholder={locale === "fr"
              ? "Parlons de votre idée…"
              : "Let's talk about your idea…"}
          />
        </label>

        <label>
          <span>04 · {copy.contact.message}</span>
          <textarea
            name="message"
            required
            minlength="20"
            maxlength="3000"
            rows="6"
            placeholder={locale === "fr"
              ? "Quelques lignes suffisent pour commencer."
              : "A few lines are enough to get started."}></textarea>
        </label>

        <p
          class="form-success"
          data-form-success
          role="status"
          aria-live="polite"
          hidden
        >
          {copy.contact.success}
        </p>

        <p class="form-error" data-form-error role="alert" hidden>
          {copy.contact.error}
        </p>

        <div class="form-bottom">
          <small>{copy.contact.note}</small>

          <button
            class="button primary"
            type="submit"
            data-form-submit
            data-label={copy.contact.send}
            data-sending-label={copy.contact.sending}
          >
            <span data-submit-label>{copy.contact.send}</span>
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </form>
    </section>
  </main>
  <Footer locale={locale} />

  <script>
    const form = document.querySelector("[data-contact-form]");
    const successMessage = document.querySelector("[data-form-success]");
    const errorMessage = document.querySelector("[data-form-error]");
    const submitButton = document.querySelector("[data-form-submit]");
    const submitLabel = document.querySelector("[data-submit-label]");

    if (form instanceof HTMLFormElement) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(submitButton instanceof HTMLButtonElement)) return;

        const accessKey = form.querySelector<HTMLInputElement>(
          'input[name="access_key"]',
        );

        if (!accessKey?.value.trim()) {
          console.error("Web3Forms access key is missing.");

          if (errorMessage instanceof HTMLElement) {
            errorMessage.hidden = false;
          }

          return;
        }

        if (successMessage instanceof HTMLElement) {
          successMessage.hidden = true;
        }

        if (errorMessage instanceof HTMLElement) {
          errorMessage.hidden = true;
        }

        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");

        if (submitLabel instanceof HTMLElement) {
          submitLabel.textContent =
            submitButton.dataset.sendingLabel ?? "Sending…";
        }

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            console.error("Web3Forms response:", result);
            throw new Error(result.message ?? "Web3Forms error");
          }

          form.reset();

          if (successMessage instanceof HTMLElement) {
            successMessage.hidden = false;
          }
        } catch (error) {
          console.error("Contact form submission failed:", error);

          if (errorMessage instanceof HTMLElement) {
            errorMessage.hidden = false;
          }
        } finally {
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");

          if (submitLabel instanceof HTMLElement) {
            submitLabel.textContent =
              submitButton.dataset.label ?? "Send message";
          }
        }
      });
    }
  </script>
</BaseLayout>
